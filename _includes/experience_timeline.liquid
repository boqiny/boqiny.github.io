<style>
  .tl {
    margin-top: 1.25rem;
  }
  .tl-item {
    display: grid;
    grid-template-columns: 88px 24px 80px 1fr;
    align-items: start;
  }
  .tl-date {
    text-align: right;
    padding: 0.3rem 0.75rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
    opacity: 0.6;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* Rail cell stretches the full row height so consecutive rows form one
     continuous line. */
  .tl-rail {
    position: relative;
    align-self: stretch;
    min-height: 100%;
  }
  .tl-rail::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
    background: var(--global-divider-color, rgba(0, 0, 0, 0.12));
  }
  /* Last entry: stop the line at its dot instead of trailing off. */
  .tl-item:last-child .tl-rail::before {
    bottom: auto;
    height: 0.85rem;
  }
  .tl-dot {
    position: absolute;
    left: 50%;
    top: 0.55rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    transform: translateX(-50%);
    background: var(--global-text-color-light, #828282);
  }
  /* Ongoing role: green marker conveys real state, not decoration. */
  .tl-item--current .tl-dot {
    background: #16a34a;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18);
  }
  .tl-item--current .tl-date {
    color: #15803d;
    opacity: 1;
    font-weight: 600;
  }
  html[data-theme="dark"] .tl-item--current .tl-dot {
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.22);
  }
  html[data-theme="dark"] .tl-item--current .tl-date {
    color: #4ade80;
  }
  .tl-logo {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tl-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6px;
  }
  .tl-body {
    padding: 0 0 2.2rem 1.15rem;
    min-width: 0;
  }
  .tl-item:last-child .tl-body {
    padding-bottom: 0.5rem;
  }
  .tl-role {
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0.1rem 0 0.1rem;
  }
  .tl-company {
    font-size: 0.93rem;
    margin: 0 0 0.15rem;
    opacity: 0.85;
  }
  .tl-company a {
    text-decoration: none;
  }
  .tl-company a:hover {
    text-decoration: underline;
  }
  .tl-meta {
    font-size: 0.82rem;
    opacity: 0.6;
    margin: 0 0 0.45rem;
  }
  .tl-desc {
    font-size: 0.92rem;
    line-height: 1.58;
    margin: 0;
    opacity: 0.92;
  }
  /* UCSD ships a navy-on-transparent wordmark; invert it onto a navy tile so it
     reads as the white-on-navy mark used on their official profiles. */
  .tl-logo--ucsd {
    background: #182b49;
    border-color: #182b49;
  }
  .tl-logo--ucsd img {
    filter: brightness(0) invert(1);
    padding: 13px 10px;
  }
  /* One block per product so distinct systems do not run together. */
  .tl-proj {
    font-size: 0.92rem;
    line-height: 1.58;
    margin: 0 0 0.5rem;
    opacity: 0.92;
  }
  .tl-proj:last-of-type {
    margin-bottom: 0;
  }
  /* Products get their own hue so they read as artifacts I built, not as the
     company and advisor references that share the page accent. */
  .tl-proj a {
    color: #0f766e;
  }
  .tl-proj a:hover {
    color: #115e59;
  }
  html[data-theme="dark"] .tl-proj a {
    color: #2dd4bf;
  }
  html[data-theme="dark"] .tl-proj a:hover {
    color: #5eead4;
  }
  .tl-pubs-label {
    font-size: 0.82rem;
    opacity: 0.6;
    margin: 0.6rem 0 0.15rem;
  }
  .tl-pubs {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .tl-pubs li {
    position: relative;
    padding-left: 0.85rem;
    margin-bottom: 0.25rem;
    opacity: 0.9;
  }
  .tl-pubs li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--global-text-color-light, #828282);
  }
  .tl-pubs .tl-venue {
    opacity: 0.65;
  }
  .tl-section-title {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    border-bottom: 1px solid var(--global-divider-color, rgba(0, 0, 0, 0.08));
    padding-bottom: 0.35rem;
  }

  @media (max-width: 640px) {
    .tl-item {
      grid-template-columns: 56px 1fr;
    }
    .tl-date {
      grid-column: 1 / -1;
      text-align: left;
      padding: 0 0 0.4rem;
      opacity: 0.7;
    }
    .tl-rail {
      display: none;
    }
    .tl-logo {
      width: 56px;
      height: 56px;
    }
    .tl-body {
      padding: 0 0 1.75rem 0.9rem;
    }
  }
</style>

